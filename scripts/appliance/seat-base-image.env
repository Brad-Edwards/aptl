# Immutable Ubuntu 26.04 cloud image from the 2026-09-18 published build.
# Operators may provide both APTL_BASE_IMAGE_URL and APTL_BASE_IMAGE_SHA256.
: "${APTL_BASE_IMAGE_URL:=https://cloud-images.ubuntu.com/releases/resolute/release-20260918/ubuntu-26.04-server-cloudimg-amd64.img}"
: "${APTL_BASE_IMAGE_SHA256:=sha256:4908fb59ccd4e87ae4e8e973b7ef56f535448eacb24a87fd787270c0048987bc}"
: "${APTL_GUEST_PYTHON_VERSION:=3.14}"
