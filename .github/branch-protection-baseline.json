{
  "source": "APTL required merge checks (issues #502, #852, #969, #1193); platform dependency audit, Trivy filesystem/IaC/image gates, OSV-scanner, and the RAES scenario gate are required on dev per ADR-026",
  "branches": {
    "main": {
      "admin_bypass_allowed": true,
      "changes_land_via_pull_request": true,
      "required_status_checks": {
        "strict": true,
        "contexts": [
          "Pre-commit hooks",
          "Docs (Vale prose lint + mkdocs strict build)",
          "Python tests + coverage",
          "MCP TypeScript tests + coverage",
          "Web frontend tests + coverage",
          "SonarCloud quality gate",
          "PR title lint"
        ]
      }
    },
    "dev": {
      "admin_bypass_allowed": true,
      "changes_land_via_pull_request": true,
      "required_status_checks": {
        "strict": true,
        "contexts": [
          "Pre-commit hooks",
          "Docs (Vale prose lint + mkdocs strict build)",
          "Python tests + coverage",
          "MCP TypeScript tests + coverage",
          "Dependency vulnerability scan",
          "Clean-install lab boot and teardown (DEP-008)",
          "Web frontend tests + coverage",
          "Trivy filesystem scan",
          "Trivy IaC / config scan",
          "Trivy image scan",
          "OSV-scanner (uv.lock)",
          "RAES scenario validation gate",
          "SonarCloud quality gate",
          "PR title lint"
        ]
      }
    }
  }
}
